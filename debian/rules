#!/usr/bin/make -f

export DEB_BUILD_MAINT_OPTIONS = hardening=+all
export CGO_ENABLED = 0

%:
	dh $@

# Build the aria-tailcat launcher. tailcat is used in-process via the pinned
# github.com/tailscale/tailcat module (see go.mod / tools.go); no separate
# tailcat binary is built or bundled into the package.
override_dh_auto_build:
	mkdir -p build
	go build -trimpath -buildvcs=false -ldflags "-s -w" -o build/aria-tailcat ./cmd/aria-tailcat

override_dh_auto_test:
	go test ./...

override_dh_auto_clean:
	rm -rf build

# Systemd-only package: dh_installinit (SysV init scripts) is not needed. Without
# an init script it would not install the /etc/default template anyway, so we
# install debian/aria-tailcat.default -> /etc/default/aria-tailcat explicitly via
# debian/install and disable dh_installinit to avoid any double-install across
# debhelper versions.
override_dh_installinit:

# Keep the /etc/default env template root-only (may carry secrets later).
override_dh_fixperms:
	dh_fixperms
	chmod 600 debian/aria-tailcat/etc/default/aria-tailcat

# Binaries are already stripped (-ldflags "-s -w"), so there is no debug info
# for dh_dwz to process; newer debhelper errors out otherwise.
override_dh_dwz:
	:
