#!/bin/sh
# aria-tailcat-service — translates /etc/default/aria-tailcat into flags and
# execs the aria-tailcat launcher, which runs the tailcat server in-process via
# the imported github.com/tailscale/tailcat module. Secrets (key/PSK) are passed
# via config file or env, never on the command line.
set -eu

: "${ARIA_TAILCAT_HOME:=/var/lib/aria-tailcat}"
export HOME="${HOME:-$ARIA_TAILCAT_HOME}"

: "${ARIA_TAILCAT_CONFIG:=/etc/aria-tailcat/config.yaml}"

mkdir -p "$ARIA_TAILCAT_HOME"

# Load /etc/default/aria-tailcat when run manually (systemd does this too).
if [ -f /etc/default/aria-tailcat ]; then
  . /etc/default/aria-tailcat
fi

ARGS=""

if [ -n "${ARIA_TAILCAT_CONFIG:-}" ] && [ -f "$ARIA_TAILCAT_CONFIG" ]; then
  ARGS="$ARGS --config $ARIA_TAILCAT_CONFIG"
fi

# tailcat reads the DERP map URL from TAILCAT_DERPMAP_URL.
if [ -n "${ARIA_TAILCAT_DERPMAP_URL:-}" ]; then
  export TAILCAT_DERPMAP_URL="$ARIA_TAILCAT_DERPMAP_URL"
fi

# A key override (optional) is passed as a flag; it is a local file path/name,
# not a secret in the wire sense.
if [ -n "${ARIA_TAILCAT_KEY:-}" ]; then
  ARGS="$ARGS --serve-key $ARIA_TAILCAT_KEY"
fi

exec /usr/bin/aria-tailcat run $ARGS
